[general]
import = [
  "/usr/lib/node_modules/alacritty-themes/themes/Ayu-Dark.toml"
]

[window]
opacity = 1

  [window.padding]
  x = 8
  y = 8

[font]
size = 11

  [font.normal]
  family = "Hack Nerd Font"
  style = "Regular"

[colors.primary]
background = "#0f1419"
foreground = "#bfbdb6"

[colors.normal]
black = "#000000"
red = "#ff3333"
green = "#b8cc52"
yellow = "#e7c547"
blue = "#36a3d9"
magenta = "#f07178"
cyan = "#95e6cb"
white = "#ffffff"
