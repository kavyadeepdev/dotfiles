*alacritty*.bak
# fontconfig cache IDs — auto-generated per font dir by fc-cache, not config
.uuid
# MIME cache — regenerated by update-desktop-database, not config
mimeinfo.cache
# suckless (dwm/dmenu/st/slstatus) build outputs — regenerated by `sudo make clean install`
# config.h is auto-copied from config.def.h by the Makefile; only config.def.h is tracked
dwm/.config/dwm/config.h
dwm/.config/dmenu/config.h
dwm/.config/st/config.h
dwm/.config/slstatus/config.h
# compiled binaries
dwm/.config/dwm/dwm
dwm/.config/dmenu/dmenu
dwm/.config/dmenu/stest
dwm/.config/st/st
dwm/.config/slstatus/slstatus
# object files and release tarballs from `make` / `make dist`
*.o
*.tar.gz
# patch leftovers
*.orig
*.rej
# editor / tool backups
*.bak
*.backup.*
*~
# runtime logs — regenerated by the app, not config
error.log